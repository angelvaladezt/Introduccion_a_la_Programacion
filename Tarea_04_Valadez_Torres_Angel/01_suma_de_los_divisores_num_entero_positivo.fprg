<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="01_suma_de_los_divisores_num_entero_positivo"/>
        <attribute name="authors" value="zacat"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-19 09:00:50 PM"/>
        <attribute name="created" value="emFjYXQ7TEFQVE9QLUg1UDI4N1BDOzIwMjYtMDktMTk7MDg6MTU6MzIgUE07Mjg0NQ=="/>
        <attribute name="edited" value="emFjYXQ7TEFQVE9QLUg1UDI4N1BDOzIwMjYtMDktMTk7MDk6MDA6NTAgUE07MTsyOTQ4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, i, suma" type="Integer" array="False" size=""/>
            <assign variable="suma" expression="0"/>
            <do expression="numero &lt;= 0">
                <output expression="&quot;Dame un numero entero positivo: &quot;" newline="True"/>
                <input variable="numero"/>
            </do>
            <output expression="&quot;La suma de todos sus divisores menores o iguales a el es:&quot;" newline="True"/>
            <for variable="i" start="1" end="numero" direction="inc" step="1">
                <if expression="numero MOD i == 0">
                    <then>
                        <output expression="i" newline="True"/>
                        <assign variable="suma" expression="suma + i"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;Total = &quot; &amp; suma" newline="True"/>
        </body>
    </function>
</flowgorithm>
