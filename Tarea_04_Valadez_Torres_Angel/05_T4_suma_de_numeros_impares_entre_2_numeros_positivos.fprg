<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="05_suma_de_numeros_impares_entre_2_numeros_positivos"/>
        <attribute name="authors" value="zacat"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-20 11:36:00 AM"/>
        <attribute name="created" value="emFjYXQ7TEFQVE9QLUg1UDI4N1BDOzIwMjYtMDktMjA7MTE6MDE6NTYgQU07MjgxNw=="/>
        <attribute name="edited" value="emFjYXQ7TEFQVE9QLUg1UDI4N1BDOzIwMjYtMDktMjA7MTE6MzY6MDAgQU07MTsyOTIy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, menor, mayor, suma, i" type="Integer" array="False" size=""/>
            <assign variable="suma" expression="0"/>
            <output expression="&quot;Dame el primer n&#250;mero entero positivo: &quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Dame el segundo n&#250;mero entero positivo: &quot;" newline="True"/>
            <input variable="num2"/>
            <if expression="num1 &lt; num2">
                <then>
                    <assign variable="menor" expression="num1"/>
                    <assign variable="mayor" expression="num2"/>
                </then>
                <else>
                    <assign variable="menor" expression="num2"/>
                    <assign variable="mayor" expression="num1"/>
                </else>
            </if>
            <for variable="i" start="menor" end="mayor" direction="inc" step="1">
                <if expression="i MOD 2 = 1">
                    <then>
                        <assign variable="suma" expression="suma + i"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;La suma de los n&#250;meros impares entre los n&#250;meros que me diste es: &quot; &amp; suma" newline="True"/>
        </body>
    </function>
</flowgorithm>
